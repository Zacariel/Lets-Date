<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JogoTextual</RootNamespace>
    <AssemblyName>LetsDate</AssemblyName>
    <!-- Permite rodar em versões mais novas do .NET se a 9 não estiver instalada -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- Os arquivos de conteúdo (NPCs, itens, flertes...) vão junto com o executável -->
  <ItemGroup>
    <None Update="Dados\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
